CODEX_WEB_HOST=0.0.0.0
CODEX_WEB_BACKEND_PORT=49380
CODEX_WEB_FRONTEND_PORT=49381
CODEX_WEB_PASSWORD=root
PUBLIC_BASE_URL=http://127.0.0.1:49380
CODEX_BIN=codex
CODEX_APP_SERVER_PORT=49317

# Backward-compatible aliases still work:
# HOST=0.0.0.0
# PORT=49380
# FRONTEND_PORT=49381

# Bridge state is stored here: events.jsonl, turns.jsonl, codex-ws-token-<port>.txt.
DATA_DIR=.data
ENABLE_EXPERIMENTAL_CODEX_API=true

# Optional: attach to an already running codex app-server instead of starting one.
# CODEX_APP_SERVER_URL=ws://127.0.0.1:49317

# Optional: require clients to send Authorization: Bearer <token>.
# BRIDGE_TOKEN=

# Optional: isolate Codex state. Leave unset to use the normal Codex home.
# CODEX_HOME=
